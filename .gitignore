# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Local lockfile generated when working inside the vendored crop package.
/third_party/crop_your_image/pubspec.lock

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Local environment and machine-specific config
.env
.env.*
!.env.example
!.env.sample
.dev.vars
**/.dev.vars
.dev.vars.*
**/.dev.vars.*
.claude/settings.local.json
.wrangler/
**/.wrangler/

# npm/yarn install caches (e.g. cloudflare/media-proxy-worker/node_modules)
node_modules/
**/node_modules/

# AI assistant local state and generated artifacts
/.codex-artifacts/
/.gemini/

# Patch/reject leftovers
*.orig
*.rej

# flutter gen-l10n diagnostic output (the generated AppLocalizations under
# lib/l10n/ is committed; this report of missing translations is transient).
/untranslated_messages.txt

# Root-level scratch screenshots and design exports
/screenshot-*.png
/demo-*.png
/kiki-home.png
/*.jpeg

# Playwright MCP scratch output (page snapshots, screenshots, console logs)
.playwright-mcp/
